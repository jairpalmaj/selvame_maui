<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <!-- ========================================== -->
    <!-- PAGES STYLES                             -->
    <!-- ========================================== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    </Style>
    
    <!--
    **Borders:** All primary containers must have a solid `4px` Bark Brown border. 
    High-priority elements like Flashcards use a `8px` heavy border.
     -->
    
    <!-- ========================================== -->
    <!-- BUTTONS STYLES                             -->
    <!-- ========================================== -->
    <Style TargetType="Button">
        <Setter Property="BorderWidth" Value="4" />
        <Setter Property="Padding" Value="8, 12" />
        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryContainer}" />
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.33" />     <!-- 32 / 24 -->
    </Style>
    
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        
    </Style>
    
    <Style x:Key="TertiaryButtonStyle" TargetType="Button">
        <Setter Property="BorderColor" Value="{StaticResource TertiaryContainer}" />
        <Setter Property="TextColor" Value="{StaticResource OnTertiaryContainer}" />
        <Setter Property="BackgroundColor" Value="{StaticResource TertiaryContainer}" />
    </Style>
    
    <Style x:Key="InvertedButtonStyle" TargetType="Button">
        <Setter Property="BorderColor" Value="{StaticResource InverseSurface}" />
        <Setter Property="TextColor" Value="{StaticResource InverseOnSurface}" />
        <Setter Property="BackgroundColor" Value="{StaticResource InverseSurface}" />
    </Style>
    
    <Style x:Key="OutlinedButtonStyle" TargetType="Button">
        <Setter Property="BorderColor" Value="{StaticResource InverseSurface}" />
        <Setter Property="TextColor" Value="{StaticResource InverseSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource InverseSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    
    <!-- ========================================== -->
    <!-- TYPOGRAPHY / LABEL STYLES                  -->
    <!-- ========================================== -->
    <!-- Font Types -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.22" />     <!-- 44 / 36 -->
    </Style>
    
    <!-- Display -->
    <Style x:Key="DisplayLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 700 -->
        <Setter Property="LineHeight" Value="1.22" />     <!-- 44 / 36 -->
    </Style>

    <!-- Headline Large -->
    <Style x:Key="HeadlineLgLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 700 -->
        <Setter Property="LineHeight" Value="1.25" />     <!-- 40 / 32 -->
    </Style>

    <!-- Headline Medium -->
    <Style x:Key="HeadlineMdLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 700 -->
        <Setter Property="LineHeight" Value="1.33" />     <!-- 32 / 24 -->
    </Style>

    <!-- Headline Small -->
    <Style x:Key="HeadlineSmLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 700 -->
        <Setter Property="LineHeight" Value="1.40" />     <!-- 28 / 20 -->
    </Style>

    <!-- Body Large -->
    <Style x:Key="BodyLgLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 700 -->
        <Setter Property="CharacterSpacing" Value="1.33" />     <!-- 32 / 24 -->
    </Style>

    <!-- Body Medium -->
    <Style x:Key="BodyMdLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 700 -->
        <Setter Property="LineHeight" Value="1.44" />     <!-- 26 / 18 -->
    </Style>

    <!-- Body Small -->
    <Style x:Key="BodySmLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" /> <!-- 600 -->
        <Setter Property="LineHeight" Value="1.43" />     <!-- 20 / 14 -->
    </Style>

    <!-- Button (Designed for a Label inside a Button/Border, or easily convertible to TargetType="Button") -->
    <Style x:Key="ButtonLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="20" />
        <!-- Weight: 400 (Normal/None) - Default, so no FontAttributes needed -->
        <Setter Property="LineHeight" Value="1.20" />     <!-- 24 / 20 -->
    </Style>

    <!-- Label Caps -->
    <Style x:Key="LabelCapsStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FredokaOne" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.33" />     <!-- 16 / 12 -->
        <Setter Property="CharacterSpacing" Value="0.05" /> <!-- 0.05em natively translates to 0.05 -->
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>
    <!-- -->
    
    <!-- ========================================== -->
    <!-- COLORS / BRUSHES                           -->
    <!-- ========================================== -->
    
    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainer}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainer}" />
    <SolidColorBrush x:Key="InversePrimaryBrush" Color="{StaticResource InversePrimary}" />
    <SolidColorBrush x:Key="PrimaryFixedBrush" Color="{StaticResource PrimaryFixed}" />
    <SolidColorBrush x:Key="PrimaryFixedDimBrush" Color="{StaticResource PrimaryFixedDim}" />
    <SolidColorBrush x:Key="OnPrimaryFixedBrush" Color="{StaticResource OnPrimaryFixed}" />
    <SolidColorBrush x:Key="OnPrimaryFixedVariantBrush" Color="{StaticResource OnPrimaryFixedVariant}" />

    <!-- Secondary Brushes -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondary}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainer}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainer}" />
    <SolidColorBrush x:Key="SecondaryFixedBrush" Color="{StaticResource SecondaryFixed}" />
    <SolidColorBrush x:Key="SecondaryFixedDimBrush" Color="{StaticResource SecondaryFixedDim}" />
    <SolidColorBrush x:Key="OnSecondaryFixedBrush" Color="{StaticResource OnSecondaryFixed}" />
    <SolidColorBrush x:Key="OnSecondaryFixedVariantBrush" Color="{StaticResource OnSecondaryFixedVariant}" />

    <!-- Tertiary Brushes -->
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiary}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainer}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainer}" />
    <SolidColorBrush x:Key="TertiaryFixedBrush" Color="{StaticResource TertiaryFixed}" />
    <SolidColorBrush x:Key="TertiaryFixedDimBrush" Color="{StaticResource TertiaryFixedDim}" />
    <SolidColorBrush x:Key="OnTertiaryFixedBrush" Color="{StaticResource OnTertiaryFixed}" />
    <SolidColorBrush x:Key="OnTertiaryFixedVariantBrush" Color="{StaticResource OnTertiaryFixedVariant}" />

    <!-- Error Brushes -->
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnError}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainer}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainer}" />

    <!-- Background & Surface Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceDimBrush" Color="{StaticResource SurfaceDim}" />
    <SolidColorBrush x:Key="SurfaceBrightBrush" Color="{StaticResource SurfaceBright}" />
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowest}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLow}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainer}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHigh}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighest}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariant}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}" />
    <SolidColorBrush x:Key="InverseSurfaceBrush" Color="{StaticResource InverseSurface}" />
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="{StaticResource InverseOnSurface}" />
    <SolidColorBrush x:Key="SurfaceTintBrush" Color="{StaticResource SurfaceTint}" />

    <!-- Outline Brushes -->
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariant}" />

    <!-- Custom / Brand Theme Brushes -->
    <SolidColorBrush x:Key="DeepSoilBrush" Color="{StaticResource DeepSoil}" />
    <SolidColorBrush x:Key="MossBrush" Color="{StaticResource Moss}" />
    <SolidColorBrush x:Key="PoisonDartRedBrush" Color="{StaticResource PoisonDartRed}" />
    <SolidColorBrush x:Key="PaperBlueBrush" Color="{StaticResource PaperBlue}" />
    <SolidColorBrush x:Key="PlasticYellowBrush" Color="{StaticResource PlasticYellow}" />
    <SolidColorBrush x:Key="GlassPurpleBrush" Color="{StaticResource GlassPurple}" />
    <SolidColorBrush x:Key="OrganicBrownBrush" Color="{StaticResource OrganicBrown}" />
    <SolidColorBrush x:Key="PureWhiteBrush" Color="{StaticResource PureWhite}" />
</ResourceDictionary>