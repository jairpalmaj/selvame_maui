<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Primary -->
    <Color x:Key="Primary">#22600a</Color>
    <Color x:Key="OnPrimary">#ffffff</Color>
    <Color x:Key="PrimaryContainer">#3b7a24</Color>
    <Color x:Key="OnPrimaryContainer">#c3ffa6</Color>
    <Color x:Key="InversePrimary">#93d876</Color>
    <Color x:Key="PrimaryFixed">#aef58f</Color>
    <Color x:Key="PrimaryFixedDim">#93d876</Color>
    <Color x:Key="OnPrimaryFixed">#052100</Color>
    <Color x:Key="OnPrimaryFixedVariant">#165200</Color>

    <!-- Secondary -->
    <Color x:Key="Secondary">#785a00</Color>
    <Color x:Key="OnSecondary">#ffffff</Color>
    <Color x:Key="SecondaryContainer">#fec733</Color>
    <Color x:Key="OnSecondaryContainer">#705400</Color>
    <Color x:Key="SecondaryFixed">#ffdf9a</Color>
    <Color x:Key="SecondaryFixedDim">#f5bf2a</Color>
    <Color x:Key="OnSecondaryFixed">#251a00</Color>
    <Color x:Key="OnSecondaryFixedVariant">#5a4300</Color>

    <!-- Tertiary -->
    <Color x:Key="Tertiary">#6e4d31</Color>
    <Color x:Key="OnTertiary">#ffffff</Color>
    <Color x:Key="TertiaryContainer">#896547</Color>
    <Color x:Key="OnTertiaryContainer">#ffecdf</Color>
    <Color x:Key="TertiaryFixed">#ffdcc2</Color>
    <Color x:Key="TertiaryFixedDim">#ebbe9a</Color>
    <Color x:Key="OnTertiaryFixed">#2d1601</Color>
    <Color x:Key="OnTertiaryFixedVariant">#5f4025</Color>

    <!-- Error -->
    <Color x:Key="Error">#ba1a1a</Color>
    <Color x:Key="OnError">#ffffff</Color>
    <Color x:Key="ErrorContainer">#ffdad6</Color>
    <Color x:Key="OnErrorContainer">#93000a</Color>

    <!-- Background & Surface -->
    <Color x:Key="Background">#fff8ef</Color>
    <Color x:Key="OnBackground">#201b0c</Color>
    <Color x:Key="Surface">#fff8ef</Color>
    <Color x:Key="SurfaceDim">#e3d9c1</Color>
    <Color x:Key="SurfaceBright">#fff8ef</Color>
    <Color x:Key="SurfaceContainerLowest">#ffffff</Color>
    <Color x:Key="SurfaceContainerLow">#fdf3da</Color>
    <Color x:Key="SurfaceContainer">#f7edd4</Color>
    <Color x:Key="SurfaceContainerHigh">#f1e8cf</Color>
    <Color x:Key="SurfaceContainerHighest">#ece2c9</Color>
    <Color x:Key="OnSurface">#201b0c</Color>
    <Color x:Key="OnSurfaceVariant">#41493c</Color>
    <Color x:Key="SurfaceVariant">#ece2c9</Color>
    <Color x:Key="InverseSurface">#35301f</Color>
    <Color x:Key="InverseOnSurface">#faf0d7</Color>
    <Color x:Key="SurfaceTint">#2d6c16</Color>

    <!-- Outline -->
    <Color x:Key="Outline">#717a6a</Color>
    <Color x:Key="OutlineVariant">#c1c9b8</Color>

    <!-- Custom / Brand Theme Colors -->
    <Color x:Key="DeepSoil">#2D2318</Color>
    <Color x:Key="Moss">#A4B494</Color>
    <Color x:Key="PoisonDartRed">#D64933</Color>
    <Color x:Key="PaperBlue">#3A86FF</Color>
    <Color x:Key="PlasticYellow">#FFBE0B</Color>
    <Color x:Key="GlassPurple">#8338EC</Color>
    <Color x:Key="OrganicBrown">#6F4E37</Color>
    <Color x:Key="PureWhite">#FFFFFF</Color>
    <Color x:Key="Gray">Gray</Color>
    <Color x:Key="Orange">#f9943b</Color>
</ResourceDictionary>