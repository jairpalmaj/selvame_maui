<?xml version="1.0" encoding="utf-8"?>

<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:ReciclaMe.Features.Common"
             Shell.NavBarIsVisible="False"
             xmlns:vm="clr-namespace:ReciclaMe.Features.ExplorerLenses"
             x:DataType="vm:LensesPageViewModel"
             x:Class="ReciclaMe.Features.ExplorerLenses.LensesPage">
    <VerticalStackLayout 
        Margin="20"
        VerticalOptions="Center"
        Spacing="12">
        <Label 
            HorizontalTextAlignment="Center"
            TextColor="{StaticResource PoisonDartRed}"
            Style="{StaticResource HeadlineSmLabelStyle}"
            Text="Simulador de camara para jugar"/>
        <Button 
            Text="Capturar para clasificar"
            Command="{Binding CaptureCommand}"/>
        <Button 
            Text="Back" 
            Style="{StaticResource SecondaryButtonStyle}"
            Command="{Binding BackCommand}" />
    </VerticalStackLayout>
</pages:BasePage>