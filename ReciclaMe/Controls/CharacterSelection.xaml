<?xml version="1.0" encoding="utf-8"?>

<Border
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Padding="8"
    x:Class="ReciclaMe.Controls.CharacterSelection"
    x:Name="This"
    BindingContext="{Binding Source={x:Reference This} }"
    xmlns:data = "clr-namespace:ReciclaMe.Controls"
    x:DataType="data:CharacterSelection"
    StrokeShape="RoundRectangle 20"
    StrokeThickness="2"
    Stroke="{StaticResource TertiaryContainer}"
    BackgroundColor="{StaticResource InverseOnSurface}">
    <Border.Shadow>
        <Shadow Brush="{StaticResource OnTertiaryFixedVariant}"
                Offset="0,8"
                Radius="1"
                Opacity="1" />
    </Border.Shadow>
    <Grid
        HorizontalOptions="Center"
        VerticalOptions="Center"
        ColumnSpacing="12"
        RowDefinitions="146, *, *"
        ColumnDefinitions="*">
        <Image
            Grid.Column="0"
            Grid.Row="0"
            Source="{Binding CharacterImageSource}" />
        <Label
            Grid.Column="0"
            Grid.Row="1"
            LineHeight="0"
            HorizontalTextAlignment="Center"
            TextColor="{StaticResource Tertiary}"
            Style="{StaticResource HeadlineSmLabelStyle}"
            Text="{Binding CharacterName}" />
        <HorizontalStackLayout
            HorizontalOptions="Center"
            Spacing="12"
            Grid.Column="0"
            Grid.Row="2">
            <Label
                LineHeight="0"
                VerticalTextAlignment="Center"
                FontFamily="GIcons"
                FontSize="26"
                TextColor="{Binding CharacterGlyphColor}"
                Text="{Binding CharacterGlyph}" />
            <Label
                LineHeight="0"
                VerticalTextAlignment="Center"
                TextColor="{StaticResource Tertiary}"
                Style="{StaticResource BodySmLabelStyle}"
                Text="{Binding CharacterSkill}" />
        </HorizontalStackLayout>
    </Grid>
    <Border.GestureRecognizers>
        <TapGestureRecognizer 
            CommandParameter="{Binding SelectCommandParameter}"
            Command="{Binding SelectCommand}"/>
    </Border.GestureRecognizers>
    <Border.Triggers>
        <DataTrigger TargetType="Border"
                     Binding="{Binding IsSelected}"
                     Value="True">
            <Setter Property="Stroke" Value="{StaticResource PrimaryContainer}" />
            <Setter Property="BackgroundColor" Value="{StaticResource OnPrimaryContainer}" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="{StaticResource Primary}"
                            Offset="0,8"
                            Radius="1"
                            Opacity="1" />
                </Setter.Value>
            </Setter>
        </DataTrigger>
        <DataTrigger TargetType="Border"
                     Binding="{Binding IsSelected}"
                     Value="False">
            <Setter Property="Stroke" Value="{StaticResource TertiaryContainer}" />
            <Setter Property="BackgroundColor" Value="{StaticResource InverseOnSurface}" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="{StaticResource OnTertiaryFixedVariant}"
                            Offset="0,8"
                            Radius="1"
                            Opacity="1" />
                </Setter.Value>
            </Setter>
        </DataTrigger>
    </Border.Triggers>
</Border>